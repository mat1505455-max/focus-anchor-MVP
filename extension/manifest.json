{
  "manifest_version": 3,
  "name": "FocusAnchor",
  "version": "0.2.0",
  "description": "A 5-second sensory anchor that interrupts the automatic scroll. Everything stays on your device.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FocusAnchor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["data.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
